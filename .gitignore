
# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Secrets and logs
.env
.env.*
!.env.example
*.log

# Raw and generated datasets
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model weights and serialized artifacts
models/*
!models/.gitkeep
*.joblib
*.safetensors
pytorch_model.bin

# Generated figures (keep evaluation images used by README)
reports/figures/*
!reports/figures/.gitkeep
!reports/figures/tfidf_baseline_test_confusion_matrix.png
!reports/figures/distilbert_test_confusion_matrix.png

# Python packaging and editor artifacts
dist/
build/
*.egg-info/
.vscode/
